# ==============================================================================
# Print Vatika - Environment Variables for Vercel & Production
# ==============================================================================
# In Vercel: Project Settings -> Environment Variables
# Copy & Paste these variables into Vercel.

# 1. Base URL of the website
NEXT_PUBLIC_APP_URL=https://printvatika.vercel.app

# 2. Master Single Admin Access Password
ADMIN_PASSWORD=vatika2026

# 3. Razorpay Payment Gateway (Indian UPI, Cards & Netbanking)
# Generate from Razorpay Dashboard -> Account & Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET

# 4. Supabase Database Configuration
# Find in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY

# 5. WhatsApp Customer Notification Number
ADMIN_WHATSAPP_NUMBER=919811427517
