# Printer Wala Vatika - Environment Variables Configuration Template
# Duplicate this file to '.env.local' and supply actual keys for production deployment.

# 1. Server Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Razorpay Indian Payment Gateway Credentials
# Find these in your Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_PUBLIC_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_SECRET_KEY_HERE

# 3. WhatsApp Business API / Provider Settings
# For official Meta WhatsApp API integration
WHATSAPP_API_TOKEN=EAA...YOUR_META_SYSTEM_USER_ACCESS_TOKEN
WHATSAPP_API_URL=https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages
ADMIN_WHATSAPP_NUMBER=919876543210

# 4. Relational Database Credentials (Supabase / PostgreSQL)
# If provided, the system overrides local file-fallback storage and queries pg
DATABASE_URL=postgresql://postgres:password@localhost:5432/printer_wala_vatika
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...YOUR_SERVICE_ROLE_KEY

# Supabase — the browser (customer auth + realtime reads) and server (order
# writes) clients read these names. NEXT_PUBLIC_* are inlined into the client
# bundle, so the anon/publishable key is safe here; the service role key is
# server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...YOUR_ANON_KEY
SUPABASE_SECRET_KEY=eyJhbGciOi...YOUR_SERVICE_ROLE_KEY
